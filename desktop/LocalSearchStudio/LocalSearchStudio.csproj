<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalSearchStudio</AssemblyName>
    <Product>FolderHunt</Product>
    <Title>FolderHunt</Title>
    <Description>Search inside your local files, notes, and documents.</Description>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../packaging/App.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../runtime/xerj.exe" Link="engine/xerj.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../notices/**/*" Link="notices/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
