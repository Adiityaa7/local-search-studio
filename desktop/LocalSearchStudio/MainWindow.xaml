<Window x:Class="LocalSearchStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderHunt" Width="1320" Height="850" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F7F8FC" FontFamily="Segoe UI" FontSize="14" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" AllowDrop="True" Drop="FolderDrop">
 <Grid Background="#F7F8FC" TextElement.Foreground="#192338">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#172337">
   <DockPanel Margin="18,28,18,22">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="9,0,0,30"><Border Background="#B5F2DB" Width="34" Height="34" CornerRadius="10"><TextBlock Text="⌕" FontSize="30" Foreground="#173C36" HorizontalAlignment="Center" Margin="0,-6,0,0"/></Border><TextBlock Text="FOLDERHUNT&#10;SEARCH INSIDE FILES" FontWeight="Bold" FontSize="12" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#92A1BA" Margin="15,8,0,12"/>
     <Button x:Name="SearchNav" Content="⌕    Search" Style="{StaticResource Nav}" Background="#2C3951" Foreground="White" Click="ShowSearch"/>
     <Button x:Name="LibraryNav" Content="▤    My folders" Style="{StaticResource Nav}" Click="ShowLibraries"/>
     <Border Height="1" Background="#324057" Margin="12,23,12,18"/>
     <TextBlock Text="ON THIS DEVICE" FontSize="10" Foreground="#92A1BA" Margin="15,0,0,12"/>
     <StackPanel Margin="15,4"><TextBlock x:Name="SidebarCount" Text="0 folders" Foreground="#E3E8F2"/><TextBlock Text="Local keyword search" FontSize="11" Foreground="#92A1BA" Margin="0,5,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button Content="?    How it works" Style="{StaticResource Nav}" Click="ShowHelp"/>
     <Button Content="ⓘ    About &amp; credits" Style="{StaticResource Nav}" Click="ShowAbout"/>
     <Border Background="#24384A" CornerRadius="10" Margin="0,18,0,0" Padding="14"><StackPanel><TextBlock Text="●  Local by design" Foreground="#A9E6D0" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your files stay on this PC." Foreground="#ADBACD" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border>
     <TextBlock Text="Powered by XERJ" Foreground="#AAB7CC" FontSize="11" Margin="14,18,0,0"/>
    </StackPanel><Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR WORK, WITHIN REACH" FontSize="10" FontWeight="SemiBold" Foreground="#7566B6"/><TextBlock x:Name="PageTitle" Text="Find your next answer." FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="PageSubtitle" Text="Search across your code, notes, and documents." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" Content="＋  Add a folder" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="AddFolder" ToolTip="Choose a folder (Ctrl+O)" IsEnabled="False"/></Grid>
   <Border x:Name="SearchBar" Grid.Row="1" Background="White" BorderBrush="#D9DDE8" BorderThickness="1" CornerRadius="12" Padding="17,12" Margin="0,0,0,20">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="24" Foreground="#7566B6" VerticalAlignment="Center"/><Grid Grid.Column="1"><TextBox x:Name="Query" BorderThickness="0" Background="Transparent" FontSize="17" VerticalContentAlignment="Center" TextChanged="QueryChanged" AutomationProperties.Name="Search your indexed files" Padding="4,5"/><TextBlock x:Name="QueryPlaceholder" Text="Search words, phrases, or a function name…" Foreground="#8A93A5" FontSize="16" VerticalAlignment="Center" Margin="5,0" IsHitTestVisible="False"/></Grid><Border Grid.Column="2" Background="#F1F3F8" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="Ctrl K" FontSize="11" Foreground="#778298"/></Border></Grid>
   </Border>
   <Grid Grid.Row="2" x:Name="SearchView">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><TextBlock x:Name="ResultsSummary" DockPanel.Dock="Right" Text="Ready when you are" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="IN" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="FolderFilter" Width="210" Padding="9,6" DisplayMemberPath="Name" SelectionChanged="FilterChanged" AutomationProperties.Name="Search folder"/></StackPanel></DockPanel>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="ResultSelected" AutomationProperties.Name="Search results">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="#ECEEF7" CornerRadius="4" Padding="6,3" Margin="10,0,0,0"><TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#605780"/></Border><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="62" FontSize="12" Foreground="#5B6679" Margin="0,9,0,10" LineHeight="19"/><TextBlock Text="{Binding Folder}" Foreground="#7366AA" FontSize="11"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8A93A5" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Grid.Column="2" Background="White" BorderBrush="#E1E5ED" BorderThickness="1" CornerRadius="12" Padding="22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="DOCUMENT PREVIEW" Foreground="#8A7CB4" FontSize="10" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,18,0,18"><TextBlock x:Name="PreviewTitle" Text="A closer look" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewPath" Text="Select a result to read its indexed text." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><TextBox Grid.Row="2" x:Name="PreviewText" Text="Your search results will appear here.&#10;&#10;Add a folder once, then search its indexed content in this window." IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="#4E5C70" FontSize="13" Padding="0" AutomationProperties.Name="Indexed document preview"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="RevealButton" Content="Show in folder ↗" Click="RevealFile" IsEnabled="False" Padding="12,8"/><Button x:Name="CopyButton" Content="Copy text" Click="CopyText" IsEnabled="False" Margin="8,0,0,0" Padding="12,8"/></StackPanel></Grid>
     </Border>
     <Border x:Name="EmptyState" Grid.Column="0" Background="#F7F8FC" Padding="22,45" VerticalAlignment="Stretch"><StackPanel VerticalAlignment="Center"><Border Width="64" Height="64" Background="#EAE5FD" CornerRadius="20" HorizontalAlignment="Left"><TextBlock Text="⌕" Foreground="#7562BC" FontSize="48" HorizontalAlignment="Center" Margin="0,-8,0,0"/></Border><TextBlock x:Name="EmptyTitle" Text="Start with a folder." FontSize="24" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock x:Name="EmptyDescription" Text="Choose a project, your notes, or a document folder. We’ll make its contents searchable on this PC." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23"/><TextBlock Text="1  Add a folder&#10;2  Index its contents&#10;3  Find the passage you need" Foreground="#70618B" LineHeight="30" FontSize="12" Margin="0,24,0,0"/></StackPanel></Border>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" x:Name="LibraryView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Refresh a folder after editing files. Existing indexes survive app restarts." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/><ListBox Grid.Row="1" x:Name="LibrariesList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Indexed folders"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,6"/><TextBlock Text="{Binding Detail}" Foreground="#6B5B9A" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="↻  Refresh" Click="RefreshFolder" Tag="{Binding}" Margin="20,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   <Border Grid.Row="3" Background="#EEF1F7" CornerRadius="9" Padding="14,10" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Starting local search engine…" Foreground="#5B687C" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CancelButton" Content="Stop indexing" Click="StopIndexing" Visibility="Collapsed" Padding="10,5" FontSize="11"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="Activity" IsIndeterminate="True" Height="3" Foreground="#8170D5" Background="#DFE4EE" Margin="0,8,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
